# Copy to backend/.env. With no key the app runs in offline demo mode.
ANTHROPIC_API_KEY=
# auto = Claude if a key is set, else local Ollama if running, else canned demo replies
# (auto | anthropic | ollama | offline)
LLM_MODE=auto

# Free local model (no key): install Ollama from https://ollama.com, then: ollama pull qwen2.5:7b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# Chat favours speed (runs every message); quizzes favour accuracy (answer keys).
CHAT_MODEL=claude-sonnet-5-5
CHAT_EFFORT=low
QUIZ_MODEL=claude-opus-5-5
QUIZ_EFFORT=medium

# Defaults to backend/data/tuition.db. Use Postgres in production, e.g.
# DATABASE_URL=postgresql+psycopg://user:pass@host/db   (also pip install "psycopg[binary]")
CORS_ORIGINS=["http://localhost:3000"]
MAX_TURNS_PER_SESSION=50
DEFAULT_BOARD=CBSE
DEFAULT_GRADE=11
