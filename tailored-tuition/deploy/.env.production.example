# Production settings for docker-compose.prod.yml.
# Copy to deploy/.env.production, fill in every CHANGE_ME, then: chmod 600 deploy/.env.production
# Never commit the filled-in file (deploy/.gitignore excludes it).

# --- Domain and HTTPS (used by Caddy) ---------------------------------------
DOMAIN=tuition.example.com
# Let's Encrypt sends certificate expiry warnings here.
ACME_EMAIL=CHANGE_ME@example.com

# --- App ----------------------------------------------------------------------
# APP_ENV is forced to "production" by docker-compose.prod.yml.
PUBLIC_URL=https://tuition.example.com
COOKIE_SECURE=true
CORS_ORIGINS=["https://tuition.example.com"]
# Guardians allowed to upload syllabus files (comma-separated, lowercase).
ADMIN_EMAILS=CHANGE_ME@example.com
# Bump when you change the privacy notice; guardians consent to a specific version.
PRIVACY_POLICY_VERSION=2026-11-17
# Must stay false in production.
SEED_DEMO_ACCOUNTS=false

# Per-student daily limits (protect your AI bill).
MAX_MESSAGES_PER_DAY=200
MAX_SESSIONS_PER_DAY=30
MAX_QUIZZES_PER_DAY=20

# --- Database (Postgres container) ---------------------------------------------
# DATABASE_URL is built from these by docker-compose.prod.yml; don't set it here.
# Use letters and digits only for the password (it goes into a URL):
#   openssl rand -hex 24
POSTGRES_USER=tuition
POSTGRES_PASSWORD=CHANGE_ME_run_openssl_rand_hex_24
POSTGRES_DB=tuition

# --- Email (verification and password-reset links) ------------------------------
# Use a transactional email provider and set up SPF, DKIM and DMARC for your domain.
EMAIL_BACKEND=smtp
SMTP_HOST=CHANGE_ME.smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=Tailored Tuition <no-reply@tuition.example.com>

# --- AI ---------------------------------------------------------------------------
LLM_MODE=anthropic
ANTHROPIC_API_KEY=CHANGE_ME
CHAT_MODEL=claude-sonnet-5-5
CHAT_EFFORT=low
QUIZ_MODEL=claude-opus-5-5
QUIZ_EFFORT=medium
